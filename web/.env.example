# Commerce backend (server-only). Production: https://exchangent.vercel.app
# Used by /api/commerce/* and the connector OAuth page (/oauth/authorize).
COMMERCE_API_URL=http://127.0.0.1:8787

# InsForge project used for email one-time-code sign-in. Both are public (browser-safe) values.
# NEXT_PUBLIC_* values are inlined at build time: set them before `next build` / in Vercel before deploying.
# If unset, the workspace runs in preview mode and /oauth/authorize shows "Sign-in is unavailable".
NEXT_PUBLIC_INSFORGE_URL=https://your-project.region.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Optional, recommended when running more than one instance: stable key for Server Action closure encryption.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
