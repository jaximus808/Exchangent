{
  "name": "@exchangent/backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file=.env.local src/server.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "proof": "node --env-file=.env.local scripts/proof.ts",
    "test:integration": "node --env-file=.env.local --test test/integration.ts",
    "test:auth-integration": "node --env-file=.env.local --test test/auth-integration.ts",
    "seed:negotiation": "node --env-file-if-exists=.env.local scripts/seed-negotiation.ts",
    "test:db": "sh test/sql/run.sh"
  },
  "dependencies": {
    "@insforge/sdk": "1.5.2",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.15.6",
    "pg": "8.16.3",
    "typescript": "7.0.2"
  }
}
