{
  "name": "@exchangent/mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Exchangent MCP server (mcp-use): buyer and seller negotiation tools that forward to the backend API",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "mcp-use dev --port ${PORT:-3100}",
    "build": "mcp-use build --inline",
    "start": "mcp-use start",
    "deploy": "mcp-use deploy",
    "typecheck": "mcp-use typecheck",
    "test": "node --test test/*.test.ts",
    "test:integration": "node test/live.integration.ts",
    "pretest": "mcp-use build --inline",
    "pretest:integration": "mcp-use build --inline"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "mcp-use": "2.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  }
}
