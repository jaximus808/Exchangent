# Copy to .env (loaded by `mcp-use start`) or export in your shell for `npm run dev`.

# MCP server port (Streamable HTTP endpoint is http://127.0.0.1:$PORT/mcp).
PORT=3100

# Exchangent backend API base URL (doc/negotiation-contract.md).
EXCHANGENT_API_URL=http://127.0.0.1:8787/api/v1

# Auth mode: "bearer" (default) forwards the caller's Authorization header;
# "oauth" signs people in to Exchangent through the mcp-use OAuth proxy.
EXCHANGENT_AUTH=bearer

# --- bearer mode only -------------------------------------------------------
# Dev-only fallback bearer token, used ONLY when an MCP request has no
# Authorization header (e.g. the mcp-use Inspector). Never set this on a
# public deployment: every header-less caller would act as this principal.
# Ignored in oauth mode.
EXCHANGENT_TOKEN=

# --- oauth mode only (EXCHANGENT_AUTH=oauth) --------------------------------
# Exchangent's authorize page in the web/ app. Required; no default.
EXCHANGENT_OAUTH_AUTHORIZE_URL=
# Backend token endpoint (doc/oauth-contract.md).
EXCHANGENT_OAUTH_TOKEN_URL=https://exchangent.vercel.app/api/v1/oauth/token
# This server's confidential client: `npm run oauth:client --prefix backend --
#   --name "Exchangent MCP" --redirect-uri <MCP_URL>/mcp/oauth/callback`
EXCHANGENT_OAUTH_CLIENT_ID=
EXCHANGENT_OAUTH_CLIENT_SECRET=
# Public origin of this server, no path (e.g. https://<server-host>). Required when
# public; the upstream redirect URI is then <MCP_URL>/mcp/oauth/callback.
# Leave it unset (commented out) for localhost: an empty value is rejected by mcp-use.
# MCP_URL=https://<server-host>
# >= 32 chars (openssl rand -base64 32). Required when public; same value on every instance.
# Keep it commented out rather than empty.
# MCP_USE_OAUTH_SECRET=
# Shared OAuth storage. Required when public; without it, memoryStorage() is used
# (localhost only, sign-ins end on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
