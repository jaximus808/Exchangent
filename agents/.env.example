# Copy to agents/.env.local (gitignored). Real environment variables override this file.

# local  = in-process queues, no Inkbox keys needed (default)
# inkbox = Inkbox A2A between agent identities, delivered through each identity's tunnel
TRANSPORT=local

# mock   = scripted MCP calls, zero model tokens (default)
# claude = one `claude -p` run per turn, using this machine's logged-in Claude Code
BRAIN=mock

# Backend origin (with or without /api/v1). Defaults to backend_url from the principals file, then http://127.0.0.1:8787
BACKEND_URL=http://127.0.0.1:8787

# Exchangent MCP server (mcp/). Each agent connects with its own bearer token from the principals file.
MCP_URL=http://127.0.0.1:3100/mcp

# Tokens written by backend/scripts/seed-negotiation.ts:
# { backend_url, buyer: { actor_id, token }, sellers: [{ seller_id, name, token }], worker: { token } }
# Relative paths resolve against agents/.
PRINCIPALS_FILE=../backend/.demo-principals.json

# How often the dispatcher polls GET /api/v1/worker/events (milliseconds)
POLL_MS=1000

# 1 = at startup, ack events older than SKIP_BACKLOG_MINUTES without delivering them (old test traffic).
# Newer backlog is still delivered, so a restart never drops a haggle in progress.
SKIP_BACKLOG=0
# SKIP_BACKLOG_MINUTES=15

# Brain turns (claude -p processes) running at once across all agents
# MAX_CONCURRENT_TURNS=4
# Backoff before each retry of a failed turn (crash/timeout; backend tool errors are not retried)
# TURN_RETRY_DELAYS_MS=2000,10000
# How often to ask the backend to sweep stale holds and past-deadline requests (ms; 0 = off)
# SWEEP_MS=60000

# --- TRANSPORT=inkbox only ---
# Admin-scoped Inkbox key (Console > API keys). It creates identities, mints one agent-scoped key per identity
# (the A2A endpoint rejects admin keys), creates webhook subscriptions and brings tunnels online.
INKBOX_API_KEY=
# Max identities this runner may create (1 buyer + 1 per seller). Free plan = 3, Developer = 10.
INKBOX_IDENTITY_CAP=3
# Handles are globally unique across Inkbox: exchangent-buyer, exchangent-<seller-name-slug>
INKBOX_HANDLE_PREFIX=exchangent
# Seller names or IDs that never get an identity (in-process delivery), so the free slots go to the sellers you
# show. Agents over the cap fall back to in-process delivery automatically.
# INKBOX_LOCAL_SELLERS=Mission Ergonomics,SoMa Office Supply
# INKBOX_BASE_URL=            # SDK API base override (testing only)
# INKBOX_A2A_BASE_URL=https://inkbox.ai   # where agent cards live: <base>/a2a/<handle>/card

# --- After-sale cases and "email your agent" (doc/resolution-contract.md) ---
# EXCHANGENT_WEB_URL=https://web-five-jet-34.vercel.app   # watch links in status replies
# INBOUND_POLL_MS=30000                                     # how often agent inboxes are read; 0 = off

# --- BRAIN=claude only ---
# Each turn is sandboxed: no built-in tools, none of your settings/plugins/hooks, only the Exchangent MCP
# server, the agent token only in the child's environment (README "BRAIN=claude").
# CLAUDE_BIN=claude
# CLAUDE_MODEL=sonnet            # default sonnet (not your Claude Code default)
# CLAUDE_TURN_BUDGET_USD=0.40    # --max-budget-usd per turn
# CLAUDE_TIMEOUT_MS=180000
# npm run start:sandboxed only: CLAUDE_CODE_OAUTH_TOKEN comes from your shell (`claude setup-token`), never this file.

# Logs: LOG_FORMAT=json for one JSON object per line
# LOG_FORMAT=json
# STATE_DIR=.state
