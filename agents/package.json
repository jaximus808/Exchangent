{
  "name": "@exchangent/agents",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "inkbox:smoke": "node --env-file-if-exists=.env.local scripts/inkbox-smoke.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@inkbox/sdk": "0.7.19",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "description": "Exchangent agent runner: dispatches backend outbox events to buyer/seller agents over a local queue or Inkbox A2A, and runs a mock or Claude brain per turn."
}
